{
  "name": "saba-yehuda-80",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor and cinematic show for Yehuda's 80th birthday. Local, offline, one laptop.",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --no-warnings=ExperimentalWarning server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "ingest": "tsx --no-warnings=ExperimentalWarning server/cli.ts ingest",
    "sample-media": "tsx --no-warnings=ExperimentalWarning scripts/sample-media.ts",
    "show": "npm run build && cross-env NODE_ENV=production tsx --no-warnings=ExperimentalWarning server/index.ts --open",
    "start": "cross-env NODE_ENV=production tsx --no-warnings=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test shared/autoshow/generate.test.ts",
    "audit:static": "node scripts/audit-static.mjs",
    "audit:api": "node scripts/audit-api.mjs",
    "audit:ui": "node scripts/audit-ui.mjs .audit/ui",
    "audit:editing": "node scripts/audit-editing.mjs .audit/editing",
    "audit:db": "node --import tsx --no-warnings=ExperimentalWarning scripts/audit-db.ts",
    "audit:theme": "node scripts/audit-theme.mjs .audit/theme",
    "autoshow": "tsx --no-warnings=ExperimentalWarning scripts/autoshow-dryrun.ts",
    "audit:guide": "node scripts/audit-guide.mjs .audit/guide",
    "demo:media": "npm run sample-media && npm run ingest",
    "demo:show": "node scripts/seed-demo-show.mjs",
    "demo:clean": "node scripts/clean-data.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:responsive": "node scripts/audit-responsive.mjs .audit/responsive",
    "audit:wiring": "node scripts/audit-wiring.mjs .audit/wiring",
    "audit:upload": "node scripts/audit-upload.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/static": "10.1.6",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/bellefair": "^5.3.0",
    "@fontsource/david-libre": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "5.3.0",
    "@fontsource/heebo": "5.3.0",
    "@fontsource/miriam-libre": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@fontsource/suez-one": "5.3.0",
    "@tanstack/react-virtual": "3.14.21",
    "exifr": "7.1.3",
    "fastify": "5.12.7",
    "ffmpeg-static": "5.3.0",
    "gsap": "3.15.0",
    "heic-convert": "2.1.0",
    "lucide": "^1.59.0",
    "lucide-react": "1.59.0",
    "puppeteer-core": "25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/heic-convert": "2.1.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
